{
  "name": "arco-design-pro-vue",
  "description": "Arco Design Pro for Vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "author": "ArcoDesign Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config ./config/vite.config.dev.ts",
    "build": "vue-tsc --noEmit && vite build --config ./config/vite.config.prod.ts",
    "report": "cross-env REPORT=true pnpm run build",
    "preview": "pnpm run build && vite preview --host",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint-staged": "pnpx lint-staged",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.vue": [
      "stylelint --fix",
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{less,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ekworp/arco-design-vue": "^2.59.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^5.6.0",
    "lodash": "^4.18.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "query-string": "^8.0.3",
    "sortablejs": "^1.15.0",
    "vue": "^3.5.44",
    "vue-echarts": "^6.7.3",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@arco-plugins/vite-vue": "^1.4.6",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@types/lodash": "^4.17.27",
    "@types/mockjs": "^1.0.10",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/babel-plugin-jsx": "^1.5.0",
    "consola": "^2.15.3",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "mockjs": "^1.1.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
